---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const news = (await getCollection('news'))
  .filter((item) => item.data.isPublished)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Новости">
  <section class="container page-head">
    <p class="eyebrow">Обновления</p><h1>Новости</h1>
    <p class="lead">Новости проекта, анонсы занятий и материалы от команды.</p>
  </section>
  <section class="container card-grid">
    {news.map((item) => (
      <a class="card" href={`/news/${item.data.slug?.trim() || item.id}`}>
        <time datetime={item.data.date.toISOString()}>{item.data.date.toLocaleDateString('ru-RU')}</time>
        <h2>{item.data.title}</h2>
        <p class="muted">{item.data.summary ?? 'Открыть новость'}</p>
      </a>
    ))}
  </section>
  {news.length === 0 && <p class="container muted">Новостей пока нет.</p>}
</BaseLayout>
