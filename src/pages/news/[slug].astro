---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.filter((item) => item.data.isPublished).map((item) => ({
    params: { slug: item.data.slug?.trim() || item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---
<BaseLayout title={item.data.title} description={item.data.summary}>
  <article class="container">
    <header class="page-head">
      <a href="/news">← Все новости</a>
      <p class="eyebrow">{item.data.date.toLocaleDateString('ru-RU')}</p>
      <h1>{item.data.title}</h1>
      {item.data.summary && <p class="lead">{item.data.summary}</p>}
    </header>
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>
