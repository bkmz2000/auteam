---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseCard from '../../components/CourseCard.astro';
import { getCollection } from 'astro:content';
import { plainText } from '../../lib/content';

const courses = (await getCollection('courses')).filter((course) => course.data.isActive);
const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const groups = categories
  .map((category) => ({
    category,
    courses: courses.filter((course) => course.data.category === (category.data.slug ?? category.id)),
  }))
  .filter((group) => group.courses.length > 0);
const categorizedIds = new Set(groups.flatMap((group) => group.courses.map((course) => course.id)));
const uncategorized = courses.filter((course) => !categorizedIds.has(course.id));
---
<BaseLayout title="Курсы и занятия">
  <section class="container page-head">
    <p class="eyebrow">Направления</p>
    <h1>Курсы и занятия</h1>
    <p class="lead">Выберите занятие по возрасту или свяжитесь с нами, если не уверены, что подойдёт.</p>
  </section>
  <div class="container course-sections">
    {groups.map(({ category, courses: categoryCourses }) => (
      <section aria-labelledby={`category-${category.data.slug ?? category.id}`}>
        <header class="category-head">
          <h2 id={`category-${category.data.slug ?? category.id}`}>{category.data.name}</h2>
          {category.data.description && <p class="muted">{plainText(category.data.description)}</p>}
        </header>
        <div class="card-grid">{categoryCourses.map((course) => <CourseCard course={course} />)}</div>
      </section>
    ))}
    {uncategorized.length > 0 && (
      <section>
        <h2>{groups.length ? 'Другие занятия' : 'Все занятия'}</h2>
        <div class="card-grid">{uncategorized.map((course) => <CourseCard course={course} />)}</div>
      </section>
    )}
    {courses.length === 0 && <p class="muted">Занятия скоро появятся. Напишите нам, и мы подскажем варианты.</p>}
  </div>
</BaseLayout>

<style>
  .course-sections { display: grid; gap: 2.5rem; }
  .category-head { margin-bottom: 1rem; }
  .category-head h2 { margin-bottom: .4rem; }
</style>
